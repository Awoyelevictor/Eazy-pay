{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User account information, balance, and security PIN",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "balance": { "type": "number" },
        "phoneNumber": { "type": "string" },
        "transactionPin": { "type": "string" },
        "isVerified": { "type": "boolean" }
      },
      "required": ["email", "balance", "transactionPin"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "History of purchases or top-ups",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["airtime", "data", "funding", "withdrawal", "electricity", "cable", "games"] },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["success", "pending", "failed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "amount", "status", "createdAt"]
    }
  },
  "auth": { "providers": ["password"] },
  "firestore": {
    "/users/{userId}": { "schema": "UserProfile", "description": "User profile" },
    "/users/{userId}/transactions/{transactionId}": { "schema": "Transaction", "description": "User transaction history" }
  }
}
// Metadata Sync: Triggering rule update to ensure Admin directory listing and direct user lookups are enabled.
